{
  "name": "app-radar-personal",
  "version": "1.0.0",
  "description": "Personal browser automation system for collecting app opportunities",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "playwright:install": "playwright install",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "automation",
    "playwright",
    "web-scraping",
    "data-collection",
    "opportunities"
  ],
  "author": "AppRadar Personal",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "p-limit": "^4.0.0",
    "p-retry": "^6.2.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "user-agents": "^1.1.174"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/sqlite3": "^3.1.11",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.1",
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}