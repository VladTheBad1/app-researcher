# Browser Configuration
HEADLESS=true
BROWSER_TIMEOUT=30000
MAX_CONCURRENT_BROWSERS=3

# Rate Limiting
REQUEST_DELAY_MIN=1000
REQUEST_DELAY_MAX=3000
MAX_RETRIES=3

# Database
DATABASE_PATH=./data/opportunities.db

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app-radar.log

# User Agent Settings
ROTATE_USER_AGENTS=true

# Stealth Mode
ENABLE_STEALTH=true
PROXY_ENABLED=false
PROXY_URL=

# API Keys (if needed for specific sources)
TWITTER_BEARER_TOKEN=
PRODUCTHUNT_API_KEY=